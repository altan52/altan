{
  "name": "ps4-arayuz-emulatoru",
  "version": "1.0.0",
  "description": "PS4 ana ekran arayüzünü masaüstünde taklit eden hayran yapımı emülatör",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:fullscreen": "electron . --fullscreen",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac"
  },
  "author": "altan52",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.altan52.ps4emu",
    "productName": "PS4 Emulator",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PS4 Emulator"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Game",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.games",
      "icon": "build/icon.png"
    }
  }
}
